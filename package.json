{
  "name": "@step-security/unity-builder",
  "private": true,
  "version": "3.0.0",
  "description": "Build Unity projects for different platforms.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/step-security/unity-builder.git"
  },
  "author": "step-security",
  "publisher": "step-security",
  "license": "MIT",
  "scripts": {
    "build": "yarn && tsc && ncc build lib --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=4"
  },
  "dependencies": {
    "@actions/cache": "^5.0.0",
    "@actions/core": "^2.0.0",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.0",
    "@actions/tool-cache": "^2.0.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^17.0.23",
    "@types/semver": "^7.3.9",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vercel/ncc": "^0.36.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "cross-env": "^7.0.3",
    "js-yaml": "^4.1.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "ts-node": "10.8.1",
    "typescript": "4.7.4",
    "vite": "^7",
    "vitest": "^4",
    "yarn-audit-fix": "^9.3.8"
  },
  "packageManager": "yarn@4.14.1",
  "homepage": "https://github.com/step-security/unity-builder#readme",
  "bugs": {
    "url": "https://github.com/step-security/unity-builder/issues"
  }
}
